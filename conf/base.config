/*
 * Per-process resources. These are the exact cpus/memory values that were
 * hardcoded inside each process in the original single-file pipeline --
 * only their location moved. ALIGN, QC and REPORT had no explicit
 * resources originally either, so they're left on Nextflow's defaults.
 */
process {

    withName: 'SORT_INDEX' {
        cpus   = 2
        memory = '3 GB'
    }
    withName: 'SNV' {
        cpus = 4
    }
    withName: 'SV' {
        cpus = 4
    }
    withName: 'STR' {
        cpus = 4
    }
    withName: 'MOSDEPTH' {
        cpus = 4
    }
    withName: 'CNV' {
        cpus = 4
    }
    withName: 'MODKIT' {
        cpus = 4
    }
}
