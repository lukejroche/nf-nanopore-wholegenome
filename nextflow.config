/*
 * ============================================================================
 *  ont-multiomics-nf
 * ============================================================================
 */

manifest {
    name        = 'ont-multiomics-nf'
    description = 'ONT long-read pipeline: align/sort, QC, SNV, SV, STR, CNV, methylation'
    mainScript  = 'main.nf'
    version     = '1.0.0'
}

params {

    // Inputs -- only --bam is wired up as an entry point right now
    pod5      = null
    fastq     = null
    bam       = null
    reference = null

    // Comma-separated, case-insensitive: qc,snv,sv,str,cnv,methylation
    analysis  = ''
    skip_sort = false

    outdir    = 'results'
    threads   = 8
}

process {

    withName: 'SORT_INDEX' {
        cpus   = 2
        memory = '2 GB'
    }
    withName: 'SNV' {
        cpus = 4
    }
    withName: 'SV' {
        cpus = 4
    }
    withName: 'STR' {
        cpus = 4
    }
    withName: 'MOSDEPTH' {
        cpus = 4
    }
    withName: 'CNV' {
        cpus = 4
    }
    withName: 'MODKIT' {
        cpus = 4
    }
}

profiles {
    docker {
        docker.enabled      = true
        singularity.enabled = false
    }
    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
        docker.enabled          = false
    }
}

timeline {
    enabled   = true
    overwrite = true
    file      = "${params.outdir}/pipeline_info/execution_timeline.html"
}
report {
    enabled   = true
    overwrite = true
    file      = "${params.outdir}/pipeline_info/execution_report.html"
}
trace {
    enabled   = true
    overwrite = true
    file      = "${params.outdir}/pipeline_info/execution_trace.txt"
}
dag {
    enabled   = true
    overwrite = true
    file      = "${params.outdir}/pipeline_info/pipeline_dag.html"
}
