/*
 * ============================================================================
 *  ont-multiomics-nf
 * ============================================================================
 */

manifest {
    name        = 'ont-multiomics-nf'
    author	= 'Luke Roche'
    description = 'ONT long-read pipeline: align/sort, QC, SNV, SV, STR, CNV, methylation'
    mainScript  = 'main.nf'
    version     = '1.0.0'
}

params {

    // Inputs -- only --bam is wired up as an entry point right now
    pod5      = null
    fastq     = null
    bam       = null
    reference = null
    
    machine = 'LAPTOP' // for testing default=LAPTOP, future SLURM & AWS
    // Comma-separated, case-insensitive: qc,snv,sv,str,cnv,methylation
    analysis  = ''
    skip_sort = false

    outdir    = 'results'
    threads   = 8
}

includeConfig 'conf/base.config'


profiles {

    laptop {
        includeConfig 'conf/laptop.config'
    }

    slurm {
        includeConfig 'conf/slurm.config'
    }

    aws {
        includeConfig 'conf/aws.config'
    }

}

timeline {
    enabled   = true
    overwrite = true
    file      = "${params.outdir}/pipeline_info/execution_timeline.html"
}
report {
    enabled   = true
    overwrite = true
    file      = "${params.outdir}/pipeline_info/execution_report.html"
}
trace {
    enabled   = true
    overwrite = true
    file      = "${params.outdir}/pipeline_info/execution_trace.txt"
}
dag {
    enabled   = true
    overwrite = true
    file      = "${params.outdir}/pipeline_info/pipeline_dag.html"
}
