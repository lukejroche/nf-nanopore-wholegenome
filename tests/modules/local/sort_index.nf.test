nextflow_process {

    name "Test Process SORT_INDEX"
    script "modules/local/sort_index.nf"
    process "SORT_INDEX"

    test("Should run without failures") {

        when {
            
            process {
                """
                input[0] = tuple(
                                 "HG002",
                                 file('${projectDir}/tests/data/HG002_small.bam')
                                )
                """
            }
        }

        then {
            assert process.success
            assert snapshot(process.out).match()
        }

    }

}
