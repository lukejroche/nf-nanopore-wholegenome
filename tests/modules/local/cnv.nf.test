nextflow_process {

    name "Test Process CNV"
    script "modules/local/cnv.nf"
    process "CNV"

    test("Should run without failures") {

        when {
            process {
                """
                input[0] = tuple(
                                 "HG002",
                                 file('${projectDir}/tests/data/HG002_small.bam'),
                                 file('${projectDir}/tests/data/HG002_small.bam.bai')
                                )
                input[1] = file("${projectDir}/tests/data/chr22_small.fa")
                input[2] = tuple(
                                    file('${projectDir}/tests/data/HG002.regions.bed.gz'),
                                    file('${projectDir}/tests/data/HG002.regions.bed.gz.csi'),
                                    file('${projectDir}/tests/data/HG002.mosdepth.summary.txt')
                                )
                """
            }
        }

        then {
            assert process.success
            assert snapshot(process.out).match()
        }

    }

}
