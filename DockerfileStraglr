FROM python:3.11-slim

LABEL maintainer="Luke Roche"

# Install system packages
RUN apt-get update && apt-get install -y procps \
    git \
    wget \
    build-essential \
    samtools \
    bedtools \
    zlib1g-dev \
    libbz2-dev \
    liblzma-dev \
    libcurl4-openssl-dev \
    && rm -rf /var/lib/apt/lists/*

# Clone Straglr
WORKDIR /opt
RUN git clone --branch v1.5.6 https://github.com/BirolLab/straglr.git

WORKDIR /opt/straglr

# Install Python dependencies
RUN sed -i '/^python>=/d' requirements.txt

RUN pip install --no-cache-dir -r requirements.txt

# Install Straglr
RUN pip install .

RUN wget -O /usr/local/bin/trf \
    https://github.com/Benson-Genomics-Lab/TRF/releases/download/v4.09.1/trf409.linux64 \
    && chmod +x /usr/local/bin/trf

ENV PATH="/opt/straglr:$PATH"

CMD ["bash"]
